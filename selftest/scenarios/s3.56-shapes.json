        "block": "minecraft:emerald_block",
        "centre": [0, 9, 0],
        "tolerance": 0.5
      },
      {
        "kind": "blockCount",
        "snapshot": "ball",
        "block": "minecraft:emerald_block",
        "min": 925,
        "max": 925
      }
    ]
  },
