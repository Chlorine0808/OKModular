  {
    "id": "s3.6-too-hard",
    "section": "3.6",
    "title": "One obsidian among stone with harvestLevel 1 keeps the recipe from starting; swapping it for stone lets it start",
    "source": "run/TESTING.md §3.6 harvestLevel より硬いブロックを 1 つ混ぜる (レシピが始まらない); docs/jp/recipes/DECORATORS.md §5 harvest_block (harvestLevel: これより硬いブロックがあるとレシピが始まりません; レシピ開始前: 硬すぎるブロックがあれば開始を断る). Obsidian needs pickaxe level 3. The swap at tick 61 is a control showing the obsidian, not the fixture, was the reason",
    "machine": {
      "structure": "selftest_harvest"
    },
    "ticks": 220,
    "steps": [
      {
        "at": 0,
        "action": "setBlock",
        "pos": [
          0,
          2,
          0
        ],
        "block": "minecraft:stone"
      },
      {
        "at": 0,
        "action": "setBlock",
        "pos": [
          0,
          3,
          0
        ],
        "block": "minecraft:obsidian"
      },
      {
        "at": 0,
        "action": "setBlock",
        "pos": [
          0,
          4,
          0
        ],
        "block": "minecraft:stone"
      },
      {
        "at": 1,
        "action": "insert",
        "inputs": [
          {
            "item": "minecraft:gravel",
            "amount": 1
          }
        ]
      },
      {
        "at": 61,
        "action": "setBlock",
        "pos": [
          0,
          3,
          0
        ],
        "block": "minecraft:stone"
      }
    ],
    "snapshots": {
      "cells": {
        "from": [
          0,
          2,
          0
        ],
        "to": [
          0,
          4,
          0
        ]
      },
      "refused": {
        "from": [
          0,
          2,
          0
        ],
        "to": [
          0,
          4,
          0
        ],
        "at": 60
      }
    },
    "expect": [
      {
        "kind": "recipeStarted",
        "value": false,
        "from": 0,
        "to": 60
      },
      {
        "kind": "blockAt",
        "snapshot": "refused",
        "pos": [
          0,
          3,
          0
        ],
        "block": "minecraft:obsidian"
      },
      {
        "kind": "recipeStarted",
        "value": true,
        "from": 61,
        "to": 200
      }
    ]
  },
