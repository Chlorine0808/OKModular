      {
        "kind": "componentTier",
        "component": "casing",
        "value": 1
      },
      {
        "kind": "recipeStarted",
        "value": true,
        "from": 0,
        "to": 40
      },
      {
        "kind": "blockFraction",
        "snapshot": "pattern",
        "block": "minecraft:emerald_block",
        "p": 0.2
      }
    ]
  },
