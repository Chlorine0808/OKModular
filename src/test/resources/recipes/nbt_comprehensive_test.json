{
  "group": "NBT Comprehensive Test - Full Feature Coverage",
  "recipes": [
    {
      "name": "Subtraction Assignment (-=)",
      "duration": 100,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": "nbt('customData.durability') >= 100"
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": [
            "nbt('customData.durability') -= 50",
            "nbt('display.Name') = 'Worn Sword'"
          ]
        }
      ]
    },
    {
      "name": "Division Assignment (/=)",
      "duration": 100,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": "nbt('customData.value') >= 1000"
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": [
            "nbt('customData.value') /= 2",
            "nbt('display.Name') = 'Halved Diamond'"
          ]
        }
      ]
    },
    {
      "name": "Less Than Comparison (<)",
      "duration": 100,
      "inputs": [
        {
          "item": "minecraft:iron_sword",
          "amount": 1,
          "nbt": "nbt('customData.temperature') < 100"
        }
      ],
      "outputs": [
        {
          "item": "minecraft:iron_sword",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Cool Sword'"
        }
      ]
    },
    {
      "name": "Less Than or Equal Comparison (<=)",
      "duration": 100,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": "nbt('customData.quality') <= 50"
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Standard Diamond'"
        }
      ]
    },
    {
      "name": "NBTList Less Than (<)",
      "duration": 150,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 16, "lvl": "<3"}
            ]
          }
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Low Sharpness Sword'",
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 16, "lvl": 5}
            ]
          }
        }
      ]
    },
    {
      "name": "NBTList Less Than or Equal (<=)",
      "duration": 150,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 34, "lvl": "<=2"}
            ]
          }
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Upgraded Unbreaking'",
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 34, "lvl": "+1"}
            ]
          }
        }
      ]
    },
    {
      "name": "NBTList Equality (==)",
      "duration": 150,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 16, "lvl": "==5"}
            ]
          }
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Exactly Sharpness V'"
        }
      ]
    },
    {
      "name": "NBTList Inequality (!=)",
      "duration": 150,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 20, "lvl": "!=0"}
            ]
          }
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": "nbt('display.Name') = 'Has Fire Aspect'",
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 20, "lvl": 0}
            ]
          }
        }
      ]
    },
    {
      "name": "Deep Nesting (3 Levels)",
      "duration": 200,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": [
            "nbt('customData.player.stats.level') = 10",
            "nbt('customData.player.stats.exp') = 5000",
            "nbt('customData.player.inventory.gold') = 999"
          ]
        }
      ]
    },
    {
      "name": "Type Suffixes - All Types",
      "duration": 250,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": [
            "nbt('data.byteValue') = 127b",
            "nbt('data.shortValue') = 32767s",
            "nbt('data.intValue') = 2147483647i",
            "nbt('data.longValue') = 9223372036854775807L",
            "nbt('data.floatValue') = 3.14159f",
            "nbt('data.doubleValue') = 2.718281828d"
          ]
        }
      ]
    },
    {
      "name": "Complex Multi-Operation Recipe",
      "duration": 400,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": [
            "nbt('customData.tier') >= 3",
            "nbt('customData.power') < 1000",
            "nbt('display.Name') != 'Broken Sword'"
          ],
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 16, "lvl": ">=3"},
              {"id": 34, "lvl": "!=0"}
            ]
          }
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": [
            "nbt('display.Name') = 'Ultimate Legendary Sword'",
            "nbt('display.Lore') = ['Tier upgraded', 'Power maximized', 'Enchantments enhanced']",
            "nbt('customData.tier') += 1",
            "nbt('customData.power') *= 3",
            "nbt('customData.bonus') = 1000i",
            "nbt('customData.rarity') = 'Legendary'"
          ],
          "nbtlist": {
            "path": "ench",
            "ops": [
              {"id": 16, "lvl": "+2"},
              {"id": 34, "lvl": "+1"},
              {"id": 20, "lvl": 2}
            ]
          }
        }
      ]
    },
    {
      "name": "All Compound Operators Combined",
      "duration": 300,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": "nbt('stats.level') >= 1"
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": [
            "nbt('stats.level') += 5",
            "nbt('stats.exp') -= 100",
            "nbt('stats.multiplier') *= 2",
            "nbt('stats.ratio') /= 4",
            "nbt('stats.final') = 999"
          ]
        }
      ]
    },
    {
      "name": "Empty to Non-Empty Array",
      "duration": 100,
      "inputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond_sword",
          "amount": 1,
          "nbt": [
            "nbt('display.Lore') = ['First line', 'Second line', 'Third line']",
            "nbt('customData.tags') = ['legendary', 'powerful', 'rare']"
          ]
        }
      ]
    },
    {
      "name": "Mixed String and Numeric Arrays",
      "duration": 150,
      "inputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1
        }
      ],
      "outputs": [
        {
          "item": "minecraft:diamond",
          "amount": 1,
          "nbt": [
            "nbt('display.Lore') = ['Quality: S-Rank', 'Value: Priceless']",
            "nbt('stats.attributes') = [100, 200, 300, 400, 500]",
            "nbt('data.flags') = [1b, 0b, 1b, 1b, 0b]"
          ]
        }
      ]
    }
  ]
}
